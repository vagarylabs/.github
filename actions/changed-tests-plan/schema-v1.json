{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/vagarylabs/.github/actions/changed-tests-plan/schema-v1.json",
  "title": "changed_tests plan, version 1",
  "description": "What a pull request's fast tier must run of its new and changed tests before merge-queue entry. One contract for every repository; the mapping from a diff to this plan stays per repository. check.py enforces this file plus the cross-field rules a JSON Schema cannot state (see its docstring).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mode", "whole_groups", "partitions", "e2e", "deleted_tests", "source_paths", "reasons"],
  "properties": {
    "version": {"const": 1},
    "mode": {"enum": ["none", "selected"]},
    "whole_groups": {"type": "array", "items": {"$ref": "#/definitions/name"}, "uniqueItems": true},
    "partitions": {
      "type": "object",
      "propertyNames": {"$ref": "#/definitions/name"},
      "additionalProperties": {"type": "array", "items": {"$ref": "#/definitions/path"}, "uniqueItems": true}
    },
    "e2e": {"type": "boolean"},
    "deleted_tests": {"type": "array", "items": {"$ref": "#/definitions/path"}, "uniqueItems": true},
    "source_paths": {"type": "array", "items": {"$ref": "#/definitions/path"}, "uniqueItems": true},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}}
  },
  "definitions": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 1024}
  }
}
