# Reusable secret-scan gate for Vagary Labs repositories.
# GENERATED from trusted/templates/secret-scan.yml.in by `python3 trusted/render.py`; edit the template.
#
# Callers add .github/workflows/secret-scan.yml:
#
#   name: secret-scan
#   on:
#     pull_request:
#     push:
#       branches: [main]
#     schedule:
#       - cron: "17 21 * * *"   # once a day: the full-history scan
#   permissions:
#     contents: read
#   jobs:
#     secret-scan:
#       uses: vagarylabs/.github/.github/workflows/secret-scan.yml@main
#
# Repositories covered by the org ruleset's trusted-secret-scan (pinned, PR-proof) get the same scanners
# from there; this reusable workflow stays for every other caller and is retired per repository once the
# trusted checks are active there.
#
# Secret detection is done in-house rather than bought: GitHub Secret Protection is not licensed
# for the private repos, by operator ruling (2026-09-29). Both engines are open source and need no key.
#
# Pattern taken from vagarylabs/vps-ansible secret-scan.yml:
#   * the gitleaks ENGINE, not gitleaks/gitleaks-action, which refuses to run for an organization
#     repository without a paid licence key;
#   * gitleaks pinned to 8.30.1 (8.24.3 silently ignores `[[allowlists]]` tables), tarball verified
#     against the release sha256;
#   * the scan covers the commits this event introduces: a PR's merge-base..head, a push's before..after.
#     A new branch, a force-push, a `before` that cannot be read, a schedule or a workflow_dispatch scans the
#     FULL history of the commit, never just the pushed commit. A PR range that cannot be resolved, or is
#     empty, is UNAVAILABLE and fails;
#   * IO: gitleaks reads a blob-less, sparse checkout and fetches only the blobs the range reads. trufflehog
#     always clones its file:// source, so it gets a separate repository fetched to depth commits+2 (checked
#     complete, deepened or failed), not the full history twice;
#   * positive control: on a non-empty range each scanner must REPORT it read something (gitleaks "N commits
#     scanned" with N > 0; trufflehog "finished scanning", and chunks > 0 when the range adds lines);
#   * trufflehog keeps verified AND unverifiable results: a verified one is a live credential (FINDINGS),
#     and one whose verification errored (provider unreachable) is UNAVAILABLE, not a silent pass.
# Each job ends in exactly one state (trusted/scanstate.py, ledger C9) in the job summary and an annotation.
name: Reusable secret scan

on:
  workflow_call:
    inputs:
      runner:
        description: >-
          Runner label. Left at the default, the caller's SECRET_SCAN_RUNNER repository variable picks the
          runner (the mini-PC bridge's vl-light label for the repositories that set it), else ubuntu-latest.
        required: false
        type: string
        default: ubuntu-latest
      full-history-blocking:
        description: >-
          The switch for the FULL-history scan (schedule, workflow_dispatch, or a push with no usable before).
          false (default, operator decision 2026-10-17): report-only. The state, reason and findings (rule, path,
          line, commit; never the secret) go to the job summary, an annotation and the scan-result-<scanner>
          artifact, and the gate exits 0. true: a full-history FINDINGS or UNAVAILABLE fails the job, like a
          range scan. Range scans (PRs, before..after pushes) always block. A step that errors still fails the job.
        required: false
        type: boolean
        default: false

permissions:
  contents: read

jobs:
  gitleaks:
    name: gitleaks
    runs-on: ${{ inputs.runner != 'ubuntu-latest' && inputs.runner || vars.SECRET_SCAN_RUNNER || 'ubuntu-latest' }}
    timeout-minutes: 10
    env:
      GITLEAKS_VERSION: "8.30.1"
      GITLEAKS_SHA256: "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"
    steps:
{{INCLUDE:_scanstate.yml.in}}
      # Full history of commits and trees, but no blobs until needed: the measured cost of this job was the
      # full-history checkout (p50 29 s of 53 s on the bridge), and gitleaks reads only the range's blobs.
      # Sparse keeps the root files (.gitleaks.toml, .gitleaksignore) and .github in the working tree.
      # The daily full-history scan (schedule / workflow_dispatch) reads every blob, so it fetches them all at once.
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          fetch-depth: 0
          filter: ${{ !(github.event_name == 'schedule' || github.event_name == 'workflow_dispatch') && 'blob:none' || '' }}
          sparse-checkout: .github
{{INCLUDE:_event_range.yml.in}}
{{INCLUDE:_hydrate.yml.in}}
      # Reuse the existing copy-then-hash cache; a cache miss still needs verified downloaded bytes.
      - name: Fetch pinned gitleaks archive
        uses: vagarylabs/.github/actions/fetch-release-asset@3014f2b6ead1a935d75f28e7e2dd173e0fd9b1b0
        timeout-minutes: 5
        with:
          tool: gitleaks
          version: ${{ env.GITLEAKS_VERSION }}
          url: https://github.com/gitleaks/gitleaks/releases/download/v${{ env.GITLEAKS_VERSION }}/gitleaks_${{ env.GITLEAKS_VERSION }}_linux_x64.tar.gz
          sha256: ${{ env.GITLEAKS_SHA256 }}
          dest: ${{ runner.temp }}/gitleaks.tar.gz
          max-time: "90"
      - name: Install gitleaks (pinned, checksum-verified)
        run: |
          set -euo pipefail
          [ "$(uname -s)-$(uname -m)" = "Linux-x86_64" ] || { echo "::error::gitleaks pin is linux_x64; runner is $(uname -s)-$(uname -m)"; exit 1; }
          tgz="$RUNNER_TEMP/gitleaks.tar.gz"
          echo "${GITLEAKS_SHA256}  $tgz" | sha256sum -c -
          mkdir -p "$RUNNER_TEMP/bin"
          tar -xzf "$tgz" -C "$RUNNER_TEMP/bin" gitleaks
          "$RUNNER_TEMP/bin/gitleaks" version | grep -qx "$GITLEAKS_VERSION"
      # gitleaks reads .gitleaks.toml (--config) and .gitleaksignore (auto) from the WORKING TREE. With a sparse,
      # blob-less checkout, a config that is in the commit but not materialised would make the scan below fall
      # back to gitleaks' defaults SILENTLY (measured: allowlist and ignore both dropped). So each one must be
      # absent from the commit, or present as exactly the committed blob; anything else stops the job.
      - name: Require the gitleaks config the scan reads (present as committed, or absent from the commit)
        run: |
          set -euo pipefail
          rev="$(git rev-parse HEAD)"
          for f in .gitleaks.toml .gitleaksignore; do
            entry="$(git ls-tree "$rev" -- "$f")"            # trees only: authoritative, never needs a blob
            if [ -z "$entry" ]; then
              if [ -e "$f" ]; then echo "::error::$f is in the working tree but not in $rev; refusing"; exit 1; fi
              echo "$f: not in $rev (gitleaks uses its default for it, as before)"; continue
            fi
            read -r _mode type oid _ <<<"$entry"
            [ "$type" = blob ] || { echo "::error::$f at $rev is a $type, not a file; refusing"; exit 1; }
            git cat-file -e "$rev:$f" || { echo "::error::$f blob $oid at $rev is not readable; refusing to scan with a default config"; exit 1; }
            [ -f "$f" ] || { echo "::error::$f is in $rev but missing from the working tree (sparse/blob-less checkout); refusing to scan with a default config"; exit 1; }
            [ "$(git hash-object -- "$f")" = "$oid" ] || { echo "::error::$f in the working tree does not match $rev:$f ($oid); refusing"; exit 1; }
            echo "$f: present, matches $rev:$f ($oid)"
          done
          # An [extend] path would make gitleaks read one more repository file; none of the callers uses one.
          if [ -f .gitleaks.toml ] && grep -qE '^[[:space:]]*path[[:space:]]*=' .gitleaks.toml; then
            echo "::error::.gitleaks.toml extends a repository file; this job does not verify extended config; refusing"; exit 1
          fi
      - name: gitleaks
        env:
          MODE: ${{ steps.range.outputs.mode }}
          LOWER: ${{ steps.range.outputs.lower }}
          HEAD_SHA: ${{ steps.range.outputs.head }}
          COMMITS: ${{ steps.range.outputs.commits }}
        run: |
          set -euo pipefail
          range="${LOWER:-unresolved}..${HEAD_SHA}"
          [ "$MODE" = full ] && range="$HEAD_SHA"   # full history: every commit reachable from head
          report="$RUNNER_TEMP/gitleaks-report.json"
          log="$RUNNER_TEMP/gitleaks.log"
          rm -f "$report"
          : > "$log"
          rc=0
          if [ "$COMMITS" -gt 0 ]; then
            echo "scanning commits: $range ($COMMITS commit(s), mode $MODE)"
            cfg=()
            [ -f .gitleaks.toml ] && cfg=(--config .gitleaks.toml)
            set +e
            "$RUNNER_TEMP/bin/gitleaks" git --no-banner --redact --exit-code 42 "${cfg[@]}" --log-opts="$range" \
              --report-format json --report-path "$report" . 2> "$log"
            rc=$?
            set -e
            cat "$log" >&2
          fi
          # --log: gitleaks must REPORT a scanned-commit count above 0, not just exit 0 (positive control).
          python3 -I "$RUNNER_TEMP/trusted/scanstate.py" gitleaks --rc "$rc" --report "$report" \
            --commits "$COMMITS" --scope "$range" --log "$log" \
            --tool-name gitleaks --tool-version "$GITLEAKS_VERSION" --tool-sha256 "$GITLEAKS_SHA256"
      - name: Scan state (gitleaks)
        if: ${{ !cancelled() }}
        env:
          MODE: ${{ steps.range.outputs.mode }}
          FULL_BLOCKING: ${{ inputs.full-history-blocking }}
        run: |
          set -euo pipefail
          ro=()
          # Report-only ONLY for a resolved full-history scan with the switch off; an unresolved range blocks.
          if [ "$MODE" = full ] && [ "$FULL_BLOCKING" != true ]; then
            ro=(--report-only)
            echo "full-history scan is REPORT-ONLY (input full-history-blocking=false): findings are reported, not enforced"
          fi
          python3 -I "$RUNNER_TEMP/trusted/scanstate.py" gate --scanner gitleaks --expect scan "${ro[@]}"
      - name: Keep scan-result-gitleaks.json (rule, path, line, commit; never the secret)
        if: ${{ !cancelled() }}
        uses: actions/upload-artifact@4cec3d8aa04e39d1a68397de0c4cd6fb9dce8ec1 # v4.6.1
        with:
          name: scan-result-gitleaks
          path: ${{ runner.temp }}/scan-records/scan-result-gitleaks.json
          retention-days: 14
          if-no-files-found: warn
          overwrite: true

  trufflehog:
    name: trufflehog (verified only)
    runs-on: ${{ inputs.runner != 'ubuntu-latest' && inputs.runner || vars.SECRET_SCAN_RUNNER || 'ubuntu-latest' }}
    timeout-minutes: 10
    env:
      TRUFFLEHOG_VERSION: "3.97.0"
      TRUFFLEHOG_SHA256: "62224de2f9dd7cd418800feb953760a302ed2f82a7c547fe1146a4874fb179e4"
    steps:
{{INCLUDE:_scanstate.yml.in}}
      # Commits and trees only, to resolve the range (vagaris: 32 MiB of 150 MiB; core: 16 of 147). The scan
      # itself reads a separate shallow repository built below, because trufflehog `git` always `git clone`s
      # its file:// source (measured on 3.97.0: a second full pack copy, and a blob-less source cannot be
      # cloned at all).
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          fetch-depth: 0
          filter: blob:none
          sparse-checkout: .github
{{INCLUDE:_event_range.yml.in}}
      # Range mode: depth commits+2 from head holds every range commit (each lies within `commits` steps of head)
      # AND the lower bound's parents, which trufflehog's merge-base walk needs (measured: depth commits+1, with
      # the lower bound on the shallow boundary, is a scan error). Checked, not assumed: the lower bound must be
      # present and off the boundary and the shallow count must equal the range count; else deepen, then
      # unshallow, then fail. Full mode fetches everything. The token lives in this step's env only.
      - name: Build the scan repository (shallow to the range; full history in full mode)
        id: scanrepo
        env:
          GH_TOKEN: ${{ github.token }}
          MODE: ${{ steps.range.outputs.mode }}
          LOWER: ${{ steps.range.outputs.lower }}
          HEAD_SHA: ${{ steps.range.outputs.head }}
          COMMITS: ${{ steps.range.outputs.commits }}
        run: |
          set -euo pipefail
          scan="$RUNNER_TEMP/scan"
          rm -rf "$scan"
          echo "dir=$scan" >> "$GITHUB_OUTPUT"
          if [ "$COMMITS" -le 0 ]; then echo "empty or unresolved range: nothing to build (the scan step records the state)"; exit 0; fi
          git init -q "$scan"
          b64="$(printf 'x-access-token:%s' "$GH_TOKEN" | base64 | tr -d '\n')"
          echo "::add-mask::$b64"
          fetch() {
            GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.extraheader GIT_CONFIG_VALUE_0="AUTHORIZATION: basic $b64" \
              git -C "$scan" fetch --quiet --no-tags --no-write-fetch-head --recurse-submodules=no "$@" \
              "${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}" "+${HEAD_SHA}:refs/heads/scan"
          }
          complete() {
            git -C "$scan" cat-file -e "${LOWER}^{commit}" 2>/dev/null || return 1
            if [ -f "$scan/.git/shallow" ] && grep -qx "$LOWER" "$scan/.git/shallow"; then return 1; fi
            [ "$(git -C "$scan" rev-list --count "${LOWER}..${HEAD_SHA}")" = "$COMMITS" ]
          }
          if [ "$MODE" = full ]; then
            fetch
            [ "$(git -C "$scan" rev-list --count "$HEAD_SHA")" = "$COMMITS" ] \
              || { echo "::error::full-history scan repository does not hold all $COMMITS commit(s)"; exit 1; }
          else
            depth=$((COMMITS + 2))
            fetch --depth="$depth"
            tries=0
            until complete; do
              tries=$((tries + 1))
              if [ "$(git -C "$scan" rev-parse --is-shallow-repository)" != true ] || [ "$tries" -gt 3 ]; then
                echo "::error::scan repository cannot hold ${LOWER}..${HEAD_SHA} ($COMMITS commit(s)); refusing a partial scan"; exit 1
              elif [ "$tries" -le 2 ]; then echo "range not complete at this depth; deepening by $depth"; fetch --deepen="$depth"
              else echo "range still not complete; fetching full history"; fetch --unshallow
              fi
            done
          fi
          git -C "$scan" symbolic-ref HEAD refs/heads/scan
          git -C "$scan" read-tree HEAD   # trufflehog reads the index; no working tree is written
          revs="${LOWER}..${HEAD_SHA}"
          [ "$MODE" = full ] && revs="$HEAD_SHA"
          added="$(git -C "$scan" log --format= --numstat "$revs" | awk '$1 ~ /^[0-9]+$/ {s += $1} END {print s + 0}')"
          echo "added=$added" >> "$GITHUB_OUTPUT"
          echo "scan repository: $(git -C "$scan" rev-list --count "$revs") commit(s) in $revs, shallow=$(git -C "$scan" rev-parse --is-shallow-repository), $added line(s) added"
      # A measured slow CDN must not force every scan to download this archive again.
      - name: Fetch pinned trufflehog archive
        uses: vagarylabs/.github/actions/fetch-release-asset@3014f2b6ead1a935d75f28e7e2dd173e0fd9b1b0
        timeout-minutes: 5
        with:
          tool: trufflehog
          version: ${{ env.TRUFFLEHOG_VERSION }}
          url: https://github.com/trufflesecurity/trufflehog/releases/download/v${{ env.TRUFFLEHOG_VERSION }}/trufflehog_${{ env.TRUFFLEHOG_VERSION }}_linux_amd64.tar.gz
          sha256: ${{ env.TRUFFLEHOG_SHA256 }}
          dest: ${{ runner.temp }}/trufflehog.tar.gz
          max-time: "90"
      - name: Install trufflehog (pinned, checksum-verified)
        run: |
          set -euo pipefail
          tgz="$RUNNER_TEMP/trufflehog.tar.gz"
          echo "${TRUFFLEHOG_SHA256}  $tgz" | sha256sum -c -
          mkdir -p "$RUNNER_TEMP/bin"
          tar -xzf "$tgz" -C "$RUNNER_TEMP/bin" trufflehog
          "$RUNNER_TEMP/bin/trufflehog" --version
      - name: trufflehog
        env:
          MODE: ${{ steps.range.outputs.mode }}
          LOWER: ${{ steps.range.outputs.lower }}
          HEAD_SHA: ${{ steps.range.outputs.head }}
          COMMITS: ${{ steps.range.outputs.commits }}
          SCAN_DIR: ${{ steps.scanrepo.outputs.dir }}
          ADDED: ${{ steps.scanrepo.outputs.added }}
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/trufflehog.jsonl"
          log="$RUNNER_TEMP/trufflehog.log"
          : > "$out"
          : > "$log"
          scope="${LOWER:-unresolved}..${HEAD_SHA}"
          since=(--since-commit "$LOWER")
          if [ "$MODE" = full ]; then scope="$HEAD_SHA"; since=(); fi
          rc=0
          if [ "$COMMITS" -gt 0 ]; then
            # --results=verified,unknown keeps the candidates whose verification ERRORED; --only-verified
            # dropped them and exited 0 when the provider could not be reached. --fail-on-scan-errors: without
            # it, an unresolvable object logs "encountered errors during scan" and exits 0 (measured).
            set +e
            "$RUNNER_TEMP/bin/trufflehog" git "file://${SCAN_DIR}" --branch HEAD "${since[@]}" \
              --results=verified,unknown --json --fail-on-scan-errors --no-update > "$out" 2> "$log"
            rc=$?
            set -e
            cat "$log" >&2
          fi
          # --log/--added: trufflehog must log 'finished scanning' and, when the range adds lines, a chunk count > 0.
          python3 -I "$RUNNER_TEMP/trusted/scanstate.py" trufflehog --rc "$rc" --results "$out" \
            --commits "$COMMITS" --scope "$scope" --log "$log" --added "${ADDED:-0}" \
            --tool-name trufflehog --tool-version "$TRUFFLEHOG_VERSION" --tool-sha256 "$TRUFFLEHOG_SHA256"
      - name: Scan state (trufflehog)
        if: ${{ !cancelled() }}
        env:
          MODE: ${{ steps.range.outputs.mode }}
          FULL_BLOCKING: ${{ inputs.full-history-blocking }}
        run: |
          set -euo pipefail
          ro=()
          # Report-only ONLY for a resolved full-history scan with the switch off; an unresolved range blocks.
          if [ "$MODE" = full ] && [ "$FULL_BLOCKING" != true ]; then
            ro=(--report-only)
            echo "full-history scan is REPORT-ONLY (input full-history-blocking=false): findings are reported, not enforced"
          fi
          python3 -I "$RUNNER_TEMP/trusted/scanstate.py" gate --scanner trufflehog --expect scan "${ro[@]}"
      - name: Keep scan-result-trufflehog.json (rule, path, line, commit; never the secret)
        if: ${{ !cancelled() }}
        uses: actions/upload-artifact@4cec3d8aa04e39d1a68397de0c4cd6fb9dce8ec1 # v4.6.1
        with:
          name: scan-result-trufflehog
          path: ${{ runner.temp }}/scan-records/scan-result-trufflehog.json
          retention-days: 14
          if-no-files-found: warn
          overwrite: true
