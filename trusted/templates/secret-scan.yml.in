# Reusable secret-scan gate for Vagary Labs repositories.
# GENERATED from trusted/templates/secret-scan.yml.in by `python3 trusted/render.py`; edit the template.
#
# Callers add .github/workflows/secret-scan.yml:
#
#   name: secret-scan
#   on:
#     pull_request:
#     push:
#       branches: [main]
#   permissions:
#     contents: read
#   jobs:
#     secret-scan:
#       uses: vagarylabs/.github/.github/workflows/secret-scan.yml@main
#
# Repositories covered by the org ruleset's trusted-secret-scan (pinned, PR-proof) get the same scanners
# from there; this reusable workflow stays for every other caller and is retired per repository once the
# trusted checks are active there.
#
# Secret detection is done in-house rather than bought: GitHub Secret Protection is not licensed
# for the private repos, by operator ruling (2026-09-29). Both engines are open source and need no key.
#
# Pattern taken from vagarylabs/vps-ansible secret-scan.yml:
#   * the gitleaks ENGINE, not gitleaks/gitleaks-action, which refuses to run for an organization
#     repository without a paid licence key;
#   * gitleaks pinned to 8.30.1 (8.24.3 silently ignores `[[allowlists]]` tables), tarball verified
#     against the release sha256;
#   * the scan covers the commits this event introduces: a PR's merge-base..head, a push's before..after.
#     A new branch, a force-push, or a `before` that cannot be read scans the whole branch range,
#     merge-base(default branch, after)..after, never just the pushed commit. A range that still cannot be
#     resolved, or is empty, is UNAVAILABLE and fails;
#   * trufflehog keeps verified AND unverifiable results: a verified one is a live credential (FINDINGS),
#     and one whose verification errored (provider unreachable) is UNAVAILABLE, not a silent pass.
# Each job ends in exactly one state (trusted/scanstate.py, ledger C9) in the job summary and an annotation.
name: Reusable secret scan

on:
  workflow_call:
    inputs:
      runner:
        description: >-
          Runner label. Left at the default, the caller's SECRET_SCAN_RUNNER repository variable picks the
          runner (the mini-PC bridge's vl-light label for the repositories that set it), else ubuntu-latest.
        required: false
        type: string
        default: ubuntu-latest

permissions:
  contents: read

jobs:
  gitleaks:
    name: gitleaks
    runs-on: ${{ inputs.runner != 'ubuntu-latest' && inputs.runner || vars.SECRET_SCAN_RUNNER || 'ubuntu-latest' }}
    timeout-minutes: 10
    env:
      GITLEAKS_VERSION: "8.30.1"
      GITLEAKS_SHA256: "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"
    steps:
{{INCLUDE:_scanstate.yml.in}}
      # Full history of commits and trees, but no blobs until needed: the measured cost of this job was the
      # full-history checkout (p50 29 s of 53 s on the bridge), and gitleaks reads only the range's blobs.
      # Sparse keeps the root files (.gitleaks.toml, .gitleaksignore) and .github in the working tree.
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          fetch-depth: 0
          filter: blob:none
          sparse-checkout: .github
{{INCLUDE:_event_range.yml.in}}
{{INCLUDE:_hydrate.yml.in}}
      # Reuse the existing copy-then-hash cache; a cache miss still needs verified downloaded bytes.
      - name: Fetch pinned gitleaks archive
        uses: vagarylabs/.github/actions/fetch-release-asset@3014f2b6ead1a935d75f28e7e2dd173e0fd9b1b0
        timeout-minutes: 5
        with:
          tool: gitleaks
          version: ${{ env.GITLEAKS_VERSION }}
          url: https://github.com/gitleaks/gitleaks/releases/download/v${{ env.GITLEAKS_VERSION }}/gitleaks_${{ env.GITLEAKS_VERSION }}_linux_x64.tar.gz
          sha256: ${{ env.GITLEAKS_SHA256 }}
          dest: ${{ runner.temp }}/gitleaks.tar.gz
          max-time: "90"
      - name: Install gitleaks (pinned, checksum-verified)
        run: |
          set -euo pipefail
          [ "$(uname -s)-$(uname -m)" = "Linux-x86_64" ] || { echo "::error::gitleaks pin is linux_x64; runner is $(uname -s)-$(uname -m)"; exit 1; }
          tgz="$RUNNER_TEMP/gitleaks.tar.gz"
          echo "${GITLEAKS_SHA256}  $tgz" | sha256sum -c -
          mkdir -p "$RUNNER_TEMP/bin"
          tar -xzf "$tgz" -C "$RUNNER_TEMP/bin" gitleaks
          "$RUNNER_TEMP/bin/gitleaks" version | grep -qx "$GITLEAKS_VERSION"
      # gitleaks reads .gitleaks.toml (--config) and .gitleaksignore (auto) from the WORKING TREE. With a sparse,
      # blob-less checkout, a config that is in the commit but not materialised would make the scan below fall
      # back to gitleaks' defaults SILENTLY (measured: allowlist and ignore both dropped). So each one must be
      # absent from the commit, or present as exactly the committed blob; anything else stops the job.
      - name: Require the gitleaks config the scan reads (present as committed, or absent from the commit)
        run: |
          set -euo pipefail
          rev="$(git rev-parse HEAD)"
          for f in .gitleaks.toml .gitleaksignore; do
            entry="$(git ls-tree "$rev" -- "$f")"            # trees only: authoritative, never needs a blob
            if [ -z "$entry" ]; then
              if [ -e "$f" ]; then echo "::error::$f is in the working tree but not in $rev; refusing"; exit 1; fi
              echo "$f: not in $rev (gitleaks uses its default for it, as before)"; continue
            fi
            read -r _mode type oid _ <<<"$entry"
            [ "$type" = blob ] || { echo "::error::$f at $rev is a $type, not a file; refusing"; exit 1; }
            git cat-file -e "$rev:$f" || { echo "::error::$f blob $oid at $rev is not readable; refusing to scan with a default config"; exit 1; }
            [ -f "$f" ] || { echo "::error::$f is in $rev but missing from the working tree (sparse/blob-less checkout); refusing to scan with a default config"; exit 1; }
            [ "$(git hash-object -- "$f")" = "$oid" ] || { echo "::error::$f in the working tree does not match $rev:$f ($oid); refusing"; exit 1; }
            echo "$f: present, matches $rev:$f ($oid)"
          done
          # An [extend] path would make gitleaks read one more repository file; none of the callers uses one.
          if [ -f .gitleaks.toml ] && grep -qE '^[[:space:]]*path[[:space:]]*=' .gitleaks.toml; then
            echo "::error::.gitleaks.toml extends a repository file; this job does not verify extended config; refusing"; exit 1
          fi
      - name: gitleaks
        env:
          LOWER: ${{ steps.range.outputs.lower }}
          HEAD_SHA: ${{ steps.range.outputs.head }}
          COMMITS: ${{ steps.range.outputs.commits }}
        run: |
          set -euo pipefail
          range="${LOWER:-unresolved}..${HEAD_SHA}"
          report="$RUNNER_TEMP/gitleaks-report.json"
          rm -f "$report"
          rc=0
          if [ "$COMMITS" -gt 0 ]; then
            echo "scanning commits: $range ($COMMITS commit(s))"
            cfg=()
            [ -f .gitleaks.toml ] && cfg=(--config .gitleaks.toml)
            set +e
            "$RUNNER_TEMP/bin/gitleaks" git --no-banner --redact --exit-code 42 "${cfg[@]}" --log-opts="$range" \
              --report-format json --report-path "$report" .
            rc=$?
            set -e
          fi
          python3 -I "$RUNNER_TEMP/trusted/scanstate.py" gitleaks --rc "$rc" --report "$report" \
            --commits "$COMMITS" --scope "$range" \
            --tool-name gitleaks --tool-version "$GITLEAKS_VERSION" --tool-sha256 "$GITLEAKS_SHA256"
      - name: Scan state (gitleaks)
        if: ${{ !cancelled() }}
        run: python3 -I "$RUNNER_TEMP/trusted/scanstate.py" gate --scanner gitleaks --expect scan

  trufflehog:
    name: trufflehog (verified only)
    runs-on: ${{ inputs.runner != 'ubuntu-latest' && inputs.runner || vars.SECRET_SCAN_RUNNER || 'ubuntu-latest' }}
    timeout-minutes: 10
    env:
      TRUFFLEHOG_VERSION: "3.97.0"
      TRUFFLEHOG_SHA256: "62224de2f9dd7cd418800feb953760a302ed2f82a7c547fe1146a4874fb179e4"
    steps:
{{INCLUDE:_scanstate.yml.in}}
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          fetch-depth: 0
{{INCLUDE:_event_range.yml.in}}
      # A measured slow CDN must not force every scan to download this archive again.
      - name: Fetch pinned trufflehog archive
        uses: vagarylabs/.github/actions/fetch-release-asset@3014f2b6ead1a935d75f28e7e2dd173e0fd9b1b0
        timeout-minutes: 5
        with:
          tool: trufflehog
          version: ${{ env.TRUFFLEHOG_VERSION }}
          url: https://github.com/trufflesecurity/trufflehog/releases/download/v${{ env.TRUFFLEHOG_VERSION }}/trufflehog_${{ env.TRUFFLEHOG_VERSION }}_linux_amd64.tar.gz
          sha256: ${{ env.TRUFFLEHOG_SHA256 }}
          dest: ${{ runner.temp }}/trufflehog.tar.gz
          max-time: "90"
      - name: Install trufflehog (pinned, checksum-verified)
        run: |
          set -euo pipefail
          tgz="$RUNNER_TEMP/trufflehog.tar.gz"
          echo "${TRUFFLEHOG_SHA256}  $tgz" | sha256sum -c -
          mkdir -p "$RUNNER_TEMP/bin"
          tar -xzf "$tgz" -C "$RUNNER_TEMP/bin" trufflehog
          "$RUNNER_TEMP/bin/trufflehog" --version
      - name: trufflehog
        env:
          SINCE: ${{ steps.range.outputs.since }}
          COMMITS: ${{ steps.range.outputs.commits }}
        run: |
          set -euo pipefail
          out="$RUNNER_TEMP/trufflehog.jsonl"
          : > "$out"
          rc=0
          if [ "$COMMITS" -gt 0 ]; then
            # --results=verified,unknown keeps the candidates whose verification ERRORED; --only-verified
            # dropped them and exited 0 when the provider could not be reached.
            set +e
            "$RUNNER_TEMP/bin/trufflehog" git "file://${GITHUB_WORKSPACE}" --branch HEAD --since-commit "$SINCE" \
              --results=verified,unknown --json --fail-on-scan-errors --no-update > "$out"
            rc=$?
            set -e
          fi
          python3 -I "$RUNNER_TEMP/trusted/scanstate.py" trufflehog --rc "$rc" --results "$out" \
            --commits "$COMMITS" --scope "${SINCE:-unresolved}..HEAD" \
            --tool-name trufflehog --tool-version "$TRUFFLEHOG_VERSION" --tool-sha256 "$TRUFFLEHOG_SHA256"
      - name: Scan state (trufflehog)
        if: ${{ !cancelled() }}
        run: python3 -I "$RUNNER_TEMP/trusted/scanstate.py" gate --scanner trufflehog --expect scan
