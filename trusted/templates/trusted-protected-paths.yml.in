# trusted-protected-paths: an org-ruleset REQUIRED WORKFLOW ("Require workflows to pass before merging").
# GENERATED from trusted/templates/trusted-protected-paths.yml.in by `python3 trusted/render.py`; edit the template.
#
# Runs from the ruleset's pinned vagarylabs/.github SHA in the TARGET repository's context. The manifest and
# classifier below are byte-identical inline copies of trusted/manifest.json and trusted/classify.py (the CI
# job trusted-tests fails on drift), so the pinned workflow bytes are the whole trust root: nothing is read
# from the PR except as data, through `git show <sha>:<path>`, and nothing from the PR is executed.
#
# Contract: classifies changed paths into protected classes (ci-judge, release, iac, authority-binding) and asks
# verify_vagaris_approval() for the Vagaris signed approval (the G-23 seam).
#
# BLOCKING (D2): a change to the shared signer (.github/workflows/sign-image.yml, trusted/tests/test_sign_image.py,
# class authority-binding, classify.BLOCKING_PATHS) FAILS this job whatever INTERIM_REPORT_ONLY says, unless
# verify_vagaris_approval() returns "verified" (not available yet). THE DOOR for a legitimate signer change is
# OUT-OF-BAND, because one account approves every PR and an in-band record would be no stronger: (1) root LIFTS (sets
# the D2 ruleset to evaluate, or re-pins it), (2) the change merges with a root R4, (3) root RESTORES (re-pins the
# ruleset's workflows rule to the new main sha), each logged in operator-acts with before and after.
# TRIGGERS: pull_request and merge_group. vagarylabs/.github main has no merge queue today (rules on main:
# deletion, non_fast_forward, pull_request, required_status_checks), so merge_group is inert there and kept for the
# target repos that do use one.
#
# INTERIM EXCEPTION (every other class and path): verify_vagaris_approval() returns "not-yet-available" and
# INTERIM_REPORT_ONLY is True, so this job REPORTS (job summary + neutral notice) and does NOT block. One org
# account cannot approve its own PR, and a blocking gate would deadlock every protected IaC change.
# THE SWITCH: in trusted/classify.py, implement verify_vagaris_approval() so it can return "verified", and set
# INTERIM_REPORT_ONLY = False in the same PR. From then on "not-yet-available", "missing" and "denied" fail the
# job; root re-pins the ruleset to that merge SHA.
name: trusted-protected-paths

on:
  pull_request:
  merge_group:

permissions:
  contents: read
  pull-requests: read

jobs:
  trusted-protected-paths:
    name: trusted-protected-paths
    # No repository guard: this job also judges vagarylabs/.github itself (D2). It runs from the ruleset's PINNED copy
    # of this file, never the PR's: only that pin makes the check a control, because a PR that edits this file or
    # trusted/classify.py to pass would otherwise judge itself.
    # RUNNER. vagarylabs/.github is PUBLIC: public repos stay GitHub-hosted and public code never runs on the bridge
    # (ratified 2026-10-21; every org runner group has allows_public_repositories=false, so a bridge label would queue
    # forever there). So hosted ubuntu-latest ONLY in that repository, and the bridge label in every other (private)
    # target. This is the ONE hosted exception, named in scripts/no_hosted_runners.py (repo, workflow and job). No
    # variable, no other fallback.
    runs-on: ${{ fromJSON(github.repository == 'vagarylabs/.github' && '"ubuntu-latest"' || '["self-hosted","Linux","X64","vl-light"]') }}
    timeout-minutes: 10
    steps:
{{INCLUDE:_shas.yml.in}}
      - name: Classify against BASE (protected-paths)
        env:
          REPO: ${{ github.repository }}
          BASE: ${{ steps.shas.outputs.base }}
          HEAD_SHA: ${{ steps.shas.outputs.head }}
        run: |
          set -euo pipefail
          d="$RUNNER_TEMP/trusted"
          mkdir -p "$d"
          cat > "$d/classify.py" <<'TRUSTED_CLASSIFY_PY'
          {{INLINE:trusted/classify.py}}
          TRUSTED_CLASSIFY_PY
          cat > "$d/manifest.json" <<'TRUSTED_MANIFEST_JSON'
          {{INLINE:trusted/manifest.json}}
          TRUSTED_MANIFEST_JSON
          # -I: isolated mode, so no PYTHON* variable and no working-directory module can reach the interpreter.
          python3 -I "$d/classify.py" protected-paths --manifest "$d/manifest.json" \
            --repo "$REPO" --base "$BASE" --head "$HEAD_SHA"
