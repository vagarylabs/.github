# Trusted secret scan: an org-ruleset REQUIRED WORKFLOW ("Require workflows to pass before merging").
# GENERATED from trusted/templates/trusted-secret-scan.yml.in by `python3 trusted/render.py`; edit the template.
#
# Runs from the ruleset's pinned vagarylabs/.github SHA, in the TARGET repository's context, so a PR cannot
# edit what judges it. The PR is DATA: its head is checked out without credentials and only read by the two
# scanners. Scan configuration (.gitleaks.toml, .gitleaksignore) is read from BASE, never from the PR, and a
# PR that adds an inline suppression marker fails. Any scanner error fails the job (fail closed).
#
# Contract: BLOCKS on findings and on errors.
name: trusted-secret-scan

on:
  pull_request:
  merge_group:

permissions:
  contents: read
  pull-requests: read

jobs:
  trusted-gitleaks:
    name: trusted-gitleaks
    # The conditional keeps the job from queueing on the public source repo, whose own PRs have no
    # bridge runner, and is the conditional the ruleset-workflow docs ask for when the source repo also
    # holds the file. It is never false in a target repository.
    if: github.repository != 'vagarylabs/.github'
    # Bridge only, never hosted (operator ruling: no GitHub budget). Hard-coded so neither a repository
    # variable nor a fallback can move the judge onto hosted minutes.
    # merge_group takes the bridge merge-queue pool (vl-mq), so a queue candidate's trusted checks never wait
    # behind PR light traffic; every other event stays on vl-light. Both lists are LITERALS: no variable can move it.
    runs-on: ${{ github.event_name == 'merge_group' && fromJSON('["self-hosted","Linux","X64","vl-mq"]') || fromJSON('["self-hosted","Linux","X64","vl-light"]') }}
    timeout-minutes: 10
    env:
      GITLEAKS_VERSION: "8.30.1"
      GITLEAKS_SHA256: "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"
    steps:
{{INCLUDE:_shas.yml.in}}
      - name: Fetch pinned gitleaks archive
        uses: vagarylabs/.github/actions/fetch-release-asset@451ce35d4919686ed9df08df87a095bf85d7e647
        timeout-minutes: 5
        with:
          tool: gitleaks
          version: ${{ env.GITLEAKS_VERSION }}
          url: https://github.com/gitleaks/gitleaks/releases/download/v${{ env.GITLEAKS_VERSION }}/gitleaks_${{ env.GITLEAKS_VERSION }}_linux_x64.tar.gz
          sha256: ${{ env.GITLEAKS_SHA256 }}
          dest: ${{ runner.temp }}/gitleaks.tar.gz
          max-time: "90"
      - name: Install gitleaks (pinned, checksum-verified)
        run: |
          set -euo pipefail
          [ "$(uname -s)-$(uname -m)" = "Linux-x86_64" ] || { echo "::error::gitleaks pin is linux_x64"; exit 1; }
          tgz="$RUNNER_TEMP/gitleaks.tar.gz"
          echo "${GITLEAKS_SHA256}  $tgz" | sha256sum -c -
          mkdir -p "$RUNNER_TEMP/bin"
          tar -xzf "$tgz" -C "$RUNNER_TEMP/bin" gitleaks
          "$RUNNER_TEMP/bin/gitleaks" version | grep -qx "$GITLEAKS_VERSION"
      - name: Refuse inline suppression markers added by the PR
        env:
          MB: ${{ steps.mb.outputs.merge_base }}
          HEAD_SHA: ${{ steps.shas.outputs.head }}
        run: |
          set -euo pipefail
          git diff --no-color --no-ext-diff --no-textconv -U0 "$MB" "$HEAD_SHA" > "$RUNNER_TEMP/added.diff"
          hits="$(grep -E '^\+' "$RUNNER_TEMP/added.diff" | grep -v -E '^\+\+\+ ' | grep -c -E 'gitleaks:allow|trufflehog:ignore' || true)"
          if [ "$hits" != 0 ]; then
            echo "::error::the PR adds $hits line(s) carrying gitleaks:allow or trufflehog:ignore; suppressions are decided on BASE, not by the PR"
            exit 1
          fi
      - name: gitleaks on base..head with BASE configuration
        env:
          BASE: ${{ steps.shas.outputs.base }}
          MB: ${{ steps.mb.outputs.merge_base }}
          HEAD_SHA: ${{ steps.shas.outputs.head }}
        run: |
          set -euo pipefail
          unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML
          cfg="$RUNNER_TEMP/gitleaks-base.toml"
          if git cat-file -e "${BASE}:.gitleaks.toml" 2>/dev/null; then
            git show "${BASE}:.gitleaks.toml" > "$cfg"
            # An [extend] path would be read from the PR checkout; refuse rather than trust it.
            if grep -qE '^[[:space:]]*path[[:space:]]*=' "$cfg"; then
              echo "::error::BASE .gitleaks.toml extends a repository file; the trusted scan cannot read config from the PR"
              exit 1
            fi
          else
            printf '[extend]\nuseDefault = true\n' > "$cfg"
          fi
          ign="$RUNNER_TEMP/gitleaks-ignore"
          mkdir -p "$ign"
          if git cat-file -e "${BASE}:.gitleaksignore" 2>/dev/null; then
            git show "${BASE}:.gitleaksignore" > "$ign/.gitleaksignore"
          fi
          range="${MB}..${HEAD_SHA}"
          echo "scanning commits: $range ($(git rev-list --count "$range") commit(s)); config from base $BASE"
          "$RUNNER_TEMP/bin/gitleaks" git --no-banner --redact --exit-code 1 \
            --config "$cfg" --gitleaks-ignore-path "$ign" --log-opts="$range" .

  trusted-trufflehog:
    name: trusted-trufflehog
    if: github.repository != 'vagarylabs/.github'
    # merge_group takes the bridge merge-queue pool (vl-mq), so a queue candidate's trusted checks never wait
    # behind PR light traffic; every other event stays on vl-light. Both lists are LITERALS: no variable can move it.
    runs-on: ${{ github.event_name == 'merge_group' && fromJSON('["self-hosted","Linux","X64","vl-mq"]') || fromJSON('["self-hosted","Linux","X64","vl-light"]') }}
    timeout-minutes: 10
    env:
      TRUFFLEHOG_VERSION: "3.97.0"
      TRUFFLEHOG_SHA256: "62224de2f9dd7cd418800feb953760a302ed2f82a7c547fe1146a4874fb179e4"
    steps:
{{INCLUDE:_shas.yml.in}}
      - name: Fetch pinned trufflehog archive
        uses: vagarylabs/.github/actions/fetch-release-asset@451ce35d4919686ed9df08df87a095bf85d7e647
        timeout-minutes: 5
        with:
          tool: trufflehog
          version: ${{ env.TRUFFLEHOG_VERSION }}
          url: https://github.com/trufflesecurity/trufflehog/releases/download/v${{ env.TRUFFLEHOG_VERSION }}/trufflehog_${{ env.TRUFFLEHOG_VERSION }}_linux_amd64.tar.gz
          sha256: ${{ env.TRUFFLEHOG_SHA256 }}
          dest: ${{ runner.temp }}/trufflehog.tar.gz
          max-time: "90"
      - name: Install trufflehog (pinned, checksum-verified)
        run: |
          set -euo pipefail
          tgz="$RUNNER_TEMP/trufflehog.tar.gz"
          echo "${TRUFFLEHOG_SHA256}  $tgz" | sha256sum -c -
          mkdir -p "$RUNNER_TEMP/bin"
          tar -xzf "$tgz" -C "$RUNNER_TEMP/bin" trufflehog
          "$RUNNER_TEMP/bin/trufflehog" --version
      - name: trufflehog on merge-base..head (verified only)
        env:
          MB: ${{ steps.mb.outputs.merge_base }}
        run: |
          set -euo pipefail
          # HEAD is the PR head (checked out and asserted above). --fail exits 183 on a verified finding;
          # any other non-zero is a scanner error, and set -e fails the job on both.
          "$RUNNER_TEMP/bin/trufflehog" git "file://${GITHUB_WORKSPACE}" --branch HEAD --since-commit "$MB" \
            --only-verified --fail --no-update
