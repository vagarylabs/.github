# Trusted secret scan: an org-ruleset REQUIRED WORKFLOW ("Require workflows to pass before merging").
# GENERATED from trusted/templates/trusted-secret-scan.yml.in by `python3 trusted/render.py`; edit the template.
#
# Runs from the ruleset's pinned vagarylabs/.github SHA, in the TARGET repository's context, so a PR cannot
# edit what judges it. The PR is DATA: its head is checked out without credentials and only read by the two
# scanners. Scan configuration (.gitleaks.toml, .gitleaksignore) is read from BASE, never from the PR, and a
# PR that adds an inline suppression marker fails.
#
# Each job ends in exactly one scan state (trusted/scanstate.py; ledger C9): PASSED, FINDINGS, UNAVAILABLE,
# NOT_APPLICABLE or AUTHORIZED_EXCEPTION, written to the job summary and to scan-result-<scanner>.json
# (artifact). Contract: BLOCKS on FINDINGS and on UNAVAILABLE. UNAVAILABLE covers an empty range, a tool fetch
# or checksum failure, a scanner error, and (trufflehog) a candidate whose verification could not complete.
# Every allowlist entry in .gitleaks.toml / .gitleaksignore must carry an approver and an unexpired expiry
# (format: trusted/README.md); an invalid or expired entry is FINDINGS.
name: trusted-secret-scan

on:
  pull_request:
  merge_group:

permissions:
  contents: read
  pull-requests: read

jobs:
  trusted-gitleaks:
    name: trusted-gitleaks
    # The conditional keeps the job from queueing on the public source repo, whose own PRs have no
    # bridge runner, and is the conditional the ruleset-workflow docs ask for when the source repo also
    # holds the file. It is never false in a target repository.
    if: github.repository != 'vagarylabs/.github'
    # Bridge only, never hosted (operator ruling: no GitHub budget). Hard-coded so neither a repository
    # variable nor a fallback can move the judge onto hosted minutes.
    runs-on: [self-hosted, Linux, X64, vl-light]
    timeout-minutes: 10
    env:
      GITLEAKS_VERSION: "8.30.1"
      GITLEAKS_SHA256: "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"
    steps:
{{INCLUDE:_scanstate.yml.in}}
{{INCLUDE:_shas.yml.in}}
{{INCLUDE:_scan_env.yml.in}}
      - name: Fetch pinned gitleaks archive
        uses: vagarylabs/.github/actions/fetch-release-asset@451ce35d4919686ed9df08df87a095bf85d7e647
        timeout-minutes: 5
        with:
          tool: gitleaks
          version: ${{ env.GITLEAKS_VERSION }}
          url: https://github.com/gitleaks/gitleaks/releases/download/v${{ env.GITLEAKS_VERSION }}/gitleaks_${{ env.GITLEAKS_VERSION }}_linux_x64.tar.gz
          sha256: ${{ env.GITLEAKS_SHA256 }}
          dest: ${{ runner.temp }}/gitleaks.tar.gz
          max-time: "90"
      - name: Install gitleaks (pinned, checksum-verified)
        run: |
          set -euo pipefail
          [ "$(uname -s)-$(uname -m)" = "Linux-x86_64" ] || { echo "::error::gitleaks pin is linux_x64"; exit 1; }
          tgz="$RUNNER_TEMP/gitleaks.tar.gz"
          echo "${GITLEAKS_SHA256}  $tgz" | sha256sum -c -
          mkdir -p "$RUNNER_TEMP/bin"
          tar -xzf "$tgz" -C "$RUNNER_TEMP/bin" gitleaks
          "$RUNNER_TEMP/bin/gitleaks" version | grep -qx "$GITLEAKS_VERSION"
      - name: Refuse inline suppression markers added by the PR
        env:
          MB: ${{ steps.mb.outputs.merge_base }}
          HEAD_SHA: ${{ steps.shas.outputs.head }}
        run: |
          set -euo pipefail
          ss="$RUNNER_TEMP/trusted/scanstate.py"
          git diff --no-color --no-ext-diff --no-textconv -U0 "$MB" "$HEAD_SHA" > "$RUNNER_TEMP/added.diff"
          hits="$(grep -E '^\+' "$RUNNER_TEMP/added.diff" | grep -v -E '^\+\+\+ ' | grep -c -E 'gitleaks:allow|trufflehog:ignore' || true)"
          if [ "$hits" != 0 ]; then
            python3 -I "$ss" record --scanner gitleaks --check markers --state FINDINGS --scope "$MB..$HEAD_SHA" \
              --reason "the PR adds $hits line(s) carrying gitleaks:allow or trufflehog:ignore; suppressions are decided on BASE, not by the PR"
          else
            python3 -I "$ss" record --scanner gitleaks --check markers --state PASSED --scope "$MB..$HEAD_SHA" \
              --reason "no inline suppression marker added"
          fi
      - name: Allowlist entries carry an approver and an unexpired expiry (HEAD's files, read as data)
        env:
          HEAD_SHA: ${{ steps.shas.outputs.head }}
        run: |
          set -euo pipefail
          # HEAD, not BASE: an expired entry fails every PR until a PR renews or removes it, and that PR passes.
          # The scan below still reads its configuration from BASE, so a renewal takes effect only once merged.
          d="$RUNNER_TEMP/exceptions"
          mkdir -p "$d"
          : > "$d/gitleaks.toml"
          : > "$d/gitleaksignore"
          if git cat-file -e "${HEAD_SHA}:.gitleaks.toml" 2>/dev/null; then git show "${HEAD_SHA}:.gitleaks.toml" > "$d/gitleaks.toml"; fi
          if git cat-file -e "${HEAD_SHA}:.gitleaksignore" 2>/dev/null; then git show "${HEAD_SHA}:.gitleaksignore" > "$d/gitleaksignore"; fi
          python3 -I "$RUNNER_TEMP/trusted/scanstate.py" exceptions \
            --gitleaks-toml "$d/gitleaks.toml" --gitleaksignore "$d/gitleaksignore"
      - name: gitleaks on merge-base..head with BASE configuration
        env:
          BASE: ${{ steps.shas.outputs.base }}
          MB: ${{ steps.mb.outputs.merge_base }}
          HEAD_SHA: ${{ steps.shas.outputs.head }}
        run: |
          set -euo pipefail
          unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML
          cfg="$RUNNER_TEMP/gitleaks-base.toml"
          if git cat-file -e "${BASE}:.gitleaks.toml" 2>/dev/null; then
            git show "${BASE}:.gitleaks.toml" > "$cfg"
            # An [extend] path would be read from the PR checkout; refuse rather than trust it.
            if grep -qE '^[[:space:]]*path[[:space:]]*=' "$cfg"; then
              echo "::error::BASE .gitleaks.toml extends a repository file; the trusted scan cannot read config from the PR"
              exit 1
            fi
          else
            printf '[extend]\nuseDefault = true\n' > "$cfg"
          fi
          ign="$RUNNER_TEMP/gitleaks-ignore"
          mkdir -p "$ign"
          if git cat-file -e "${BASE}:.gitleaksignore" 2>/dev/null; then
            git show "${BASE}:.gitleaksignore" > "$ign/.gitleaksignore"
          fi
          range="${MB}..${HEAD_SHA}"
          commits="$(git rev-list --count "$range")"
          echo "scanning commits: $range ($commits commit(s)); config from base $BASE"
          report="$RUNNER_TEMP/gitleaks-report.json"
          rm -f "$report"
          set +e
          "$RUNNER_TEMP/bin/gitleaks" git --no-banner --redact --exit-code 42 \
            --config "$cfg" --gitleaks-ignore-path "$ign" --log-opts="$range" \
            --report-format json --report-path "$report" .
          rc=$?
          set -e
          python3 -I "$RUNNER_TEMP/trusted/scanstate.py" gitleaks --rc "$rc" --report "$report" \
            --commits "$commits" --scope "$range" \
            --tool-name gitleaks --tool-version "$GITLEAKS_VERSION" --tool-sha256 "$GITLEAKS_SHA256"
      - name: Scan state (gitleaks)
        if: ${{ !cancelled() }}
        run: python3 -I "$RUNNER_TEMP/trusted/scanstate.py" gate --scanner gitleaks --expect markers,exceptions,scan
      - name: Keep scan-result-gitleaks.json
        if: ${{ !cancelled() }}
        uses: actions/upload-artifact@4cec3d8aa04e39d1a68397de0c4cd6fb9dce8ec1 # v4.6.1
        with:
          name: scan-result-gitleaks
          path: ${{ runner.temp }}/scan-records/scan-result-gitleaks.json
          retention-days: 14

  trusted-trufflehog:
    name: trusted-trufflehog
    if: github.repository != 'vagarylabs/.github'
    runs-on: [self-hosted, Linux, X64, vl-light]
    timeout-minutes: 10
    env:
      TRUFFLEHOG_VERSION: "3.97.0"
      TRUFFLEHOG_SHA256: "62224de2f9dd7cd418800feb953760a302ed2f82a7c547fe1146a4874fb179e4"
    steps:
{{INCLUDE:_scanstate.yml.in}}
{{INCLUDE:_shas.yml.in}}
{{INCLUDE:_scan_env.yml.in}}
      - name: Fetch pinned trufflehog archive
        uses: vagarylabs/.github/actions/fetch-release-asset@451ce35d4919686ed9df08df87a095bf85d7e647
        timeout-minutes: 5
        with:
          tool: trufflehog
          version: ${{ env.TRUFFLEHOG_VERSION }}
          url: https://github.com/trufflesecurity/trufflehog/releases/download/v${{ env.TRUFFLEHOG_VERSION }}/trufflehog_${{ env.TRUFFLEHOG_VERSION }}_linux_amd64.tar.gz
          sha256: ${{ env.TRUFFLEHOG_SHA256 }}
          dest: ${{ runner.temp }}/trufflehog.tar.gz
          max-time: "90"
      - name: Install trufflehog (pinned, checksum-verified)
        run: |
          set -euo pipefail
          tgz="$RUNNER_TEMP/trufflehog.tar.gz"
          echo "${TRUFFLEHOG_SHA256}  $tgz" | sha256sum -c -
          mkdir -p "$RUNNER_TEMP/bin"
          tar -xzf "$tgz" -C "$RUNNER_TEMP/bin" trufflehog
          "$RUNNER_TEMP/bin/trufflehog" --version
      - name: trufflehog on merge-base..head (verified, and unverifiable kept)
        env:
          MB: ${{ steps.mb.outputs.merge_base }}
        run: |
          set -euo pipefail
          # --results=verified,unknown: a verified result is a live credential; an "unknown" one is a candidate
          # whose verification ERRORED (provider unreachable, timeout). `--only-verified` drops the unknown ones
          # and exits 0, which read a verifier outage as a pass. --fail-on-scan-errors: a scan error exits non-zero.
          out="$RUNNER_TEMP/trufflehog.jsonl"
          commits="$(git rev-list --count "${MB}..HEAD")"
          set +e
          "$RUNNER_TEMP/bin/trufflehog" git "file://${GITHUB_WORKSPACE}" --branch HEAD --since-commit "$MB" \
            --results=verified,unknown --json --fail-on-scan-errors --no-update > "$out"
          rc=$?
          set -e
          python3 -I "$RUNNER_TEMP/trusted/scanstate.py" trufflehog --rc "$rc" --results "$out" \
            --commits "$commits" --scope "${MB}..HEAD" \
            --tool-name trufflehog --tool-version "$TRUFFLEHOG_VERSION" --tool-sha256 "$TRUFFLEHOG_SHA256"
      - name: Scan state (trufflehog)
        if: ${{ !cancelled() }}
        run: python3 -I "$RUNNER_TEMP/trusted/scanstate.py" gate --scanner trufflehog --expect scan
      - name: Keep scan-result-trufflehog.json
        if: ${{ !cancelled() }}
        uses: actions/upload-artifact@4cec3d8aa04e39d1a68397de0c4cd6fb9dce8ec1 # v4.6.1
        with:
          name: scan-result-trufflehog
          path: ${{ runner.temp }}/scan-records/scan-result-trufflehog.json
          retention-days: 14
