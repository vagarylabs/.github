# trusted-workflow-integrity: an org-ruleset REQUIRED WORKFLOW ("Require workflows to pass before merging").
# GENERATED from trusted/templates/trusted-workflow-integrity.yml.in by `python3 trusted/render.py`; edit the template.
#
# Runs from the ruleset's pinned vagarylabs/.github SHA in the TARGET repository's context. The manifest and
# classifier below are byte-identical inline copies of trusted/manifest.json and trusted/classify.py (the CI
# job trusted-tests fails on drift), so the pinned workflow bytes are the whole trust root: nothing is read
# from the PR except as data, through `git show <sha>:<path>`, and nothing from the PR is executed.
#
# Contract: BLOCKS only on integrity errors (a base or head that is not an exact resolvable SHA, an invalid
# manifest, a ratchet file that does not parse). Every change to a declared protected workflow, protected path
# or ratchet constant is REPORTED (job summary + notice annotation) as a protected-path change; deciding on it
# is trusted-protected-paths' job. Ratchet constants are compared against the base side with ast.parse (parsed,
# never executed), not against the constants the PR's own checkout carries.
#
# FL-4 (report-only): the same step REPORTS test-weakening predicates over the diff's +/- lines (a test skip or
# todo, a retry, continue-on-error, a swallowed test failure, a deleted test with no successor, a loosened
# budget or timeout) as a job-summary section plus warning annotations. A finding never changes the exit code,
# and a scan failure is reported as INCOMPLETE, never as clean. Every git read of the scan runs under one time
# and byte budget (a file over the blob cap is never diffed); running out is INCOMPLETE too, never a red job and
# never a silent pass. A quarantine or approval reference is listed and never honoured until a verifier for
# those records exists.
#
# timeout-floor (a SEPARATE job, same trust posture: same repository guard, bridge runner, read-only permissions,
# exact SHAs from the event payload, the PR head checked out as data, the same inline classifier and manifest) reads
# every .github/workflows/*.yml and *.yaml of the HEAD tree as data and checks each job's timeout-minutes against the
# manifest's completion floor (timeout_floor.minutes, 6): a runner's CompleteJob call can stall 100 s and retry, and a
# job whose timeout runs out meanwhile is cancelled after it succeeded. It reads the head tree only, and every PR of
# every repo pays for it, so it checks out the head commit alone (fetch-depth 1, no merge-base); the base is
# validated as a SHA, never resolved. Under the floor or an expression is a violation unless an exemption in the
# manifest names it exactly; a job-level `uses:` is skipped; what the stdlib reader cannot judge is INCOMPLETE, never
# a pass. The job summary lists every finding and carries a TSV block (one row per job) for diffing against the
# timeout census. Mode `report` (today) fails only on integrity errors, as the job above does; mode `enforce` also
# fails on an unexempted violation or anything INCOMPLETE. The integrity job's contract above is unchanged.
name: trusted-workflow-integrity

on:
  pull_request:
  merge_group:

permissions:
  contents: read
  pull-requests: read

jobs:
  trusted-workflow-integrity:
    name: trusted-workflow-integrity
    # Keeps the job off the public source repo (no bridge runner there); never false in a target repo.
    if: github.repository != 'vagarylabs/.github'
    # Bridge only, never hosted (operator ruling: no GitHub budget); hard-coded, no variable, no fallback.
    runs-on: [self-hosted, Linux, X64, vl-light]
    timeout-minutes: 10
    steps:
{{INCLUDE:_shas.yml.in}}
      - name: Classify against BASE (integrity)
        env:
          REPO: ${{ github.repository }}
          BASE: ${{ steps.shas.outputs.base }}
          HEAD_SHA: ${{ steps.shas.outputs.head }}
        run: |
          set -euo pipefail
          d="$RUNNER_TEMP/trusted"
          mkdir -p "$d"
          cat > "$d/classify.py" <<'TRUSTED_CLASSIFY_PY'
          {{INLINE:trusted/classify.py}}
          TRUSTED_CLASSIFY_PY
          cat > "$d/manifest.json" <<'TRUSTED_MANIFEST_JSON'
          {{INLINE:trusted/manifest.json}}
          TRUSTED_MANIFEST_JSON
          # -I: isolated mode, so no PYTHON* variable and no working-directory module can reach the interpreter.
          python3 -I "$d/classify.py" integrity --manifest "$d/manifest.json" \
            --repo "$REPO" --base "$BASE" --head "$HEAD_SHA"

  timeout-floor:
    name: timeout-floor
    # Same guard, runner and timeout as the job above; it inherits the workflow's read-only permissions.
    if: github.repository != 'vagarylabs/.github'
    runs-on: [self-hosted, Linux, X64, vl-light]
    timeout-minutes: 10
    steps:
{{INCLUDE:_resolve_shas.yml.in}}
      - name: Check out the PR head alone as data (depth 1, no credentials kept, nothing executed)
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          ref: ${{ steps.shas.outputs.head }}
          fetch-depth: 1
          persist-credentials: false
      # classify.py checks the head commit is in the object store; the base is validated as a SHA, never resolved.
      - name: Check every job's timeout-minutes against the completion floor (HEAD tree)
        env:
          REPO: ${{ github.repository }}
          BASE: ${{ steps.shas.outputs.base }}
          HEAD_SHA: ${{ steps.shas.outputs.head }}
        run: |
          set -euo pipefail
          d="$RUNNER_TEMP/trusted"
          mkdir -p "$d"
          cat > "$d/classify.py" <<'TRUSTED_CLASSIFY_PY'
          {{INLINE:trusted/classify.py}}
          TRUSTED_CLASSIFY_PY
          cat > "$d/manifest.json" <<'TRUSTED_MANIFEST_JSON'
          {{INLINE:trusted/manifest.json}}
          TRUSTED_MANIFEST_JSON
          # -I: isolated mode, so no PYTHON* variable and no working-directory module can reach the interpreter.
          python3 -I "$d/classify.py" timeout-floor --manifest "$d/manifest.json" \
            --repo "$REPO" --base "$BASE" --head "$HEAD_SHA"
